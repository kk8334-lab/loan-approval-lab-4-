  <decision id="Decision_LoanEligibility_v2" name="Loan Eligibility">
    <decisionTable id="DecisionTable_0enrdy7" hitPolicy="FIRST">
      <input id="Input_1" label="Monthly Income">
        <inputExpression id="InputExpression_1" typeRef="number">
          <text>monthlyIncome</text>
        </inputExpression>
      </input>
      <input id="InputClause_11ydnyb" label="Loan to Income Multiple">
